{
  "functions": {
    "api/ops/index.js": {
      "maxDuration": 30,
      "includeFiles": "docs/ops/souls/**"
    },
    "api/web/index.js": {
      "maxDuration": 10,
      "includeFiles": "api/web/_site/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' https://images.unsplash.com https://i.ytimg.com data: blob:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com; base-uri 'self'; form-action 'self' https://accounts.google.com; object-src 'none'" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    },
    {
      "source": "/ops(.*)",
      "headers": [
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(self), geolocation=()" }
      ]
    },
    {
      "source": "/web/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/ops", "destination": "/api/ops" },
    { "source": "/ops/", "destination": "/api/ops" },
    { "source": "/ops/chat/:agent", "destination": "/api/ops?area=chat&agent=:agent" },
    { "source": "/ops/chat", "destination": "/api/ops?area=chat" },
    { "source": "/ops/desk-talk/:agent/:kind", "destination": "/api/ops?area=api/desk-talk/:agent/:kind&agent=:agent" },
    { "source": "/ops/ceo-bridge/:kind", "destination": "/api/ops?area=api/ceo-bridge/:kind" },
    { "source": "/ops/ceo-assign/:kind", "destination": "/api/ops?area=api/ceo-assign/:kind" },
    { "source": "/ops/api/desk-talk/:agent/:kind", "destination": "/api/ops?area=api/desk-talk/:agent/:kind&agent=:agent" },
    { "source": "/ops/api/ceo-bridge/:kind", "destination": "/api/ops?area=api/ceo-bridge/:kind" },
    { "source": "/ops/api/ceo-assign/:kind", "destination": "/api/ops?area=api/ceo-assign/:kind" },
    { "source": "/ops/:path*", "destination": "/api/ops?area=:path*" },
    { "source": "/os/", "destination": "/api/os" },
    { "source": "/os/:path*", "destination": "/api/os?area=:path*" },
    { "source": "/web", "destination": "/api/web?area=" },
    { "source": "/web/", "destination": "/api/web?area=" },
    { "source": "/web/:path*/", "destination": "/api/web?area=:path*/" },
    { "source": "/web/:path*", "destination": "/api/web?area=:path*" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/schedule", "destination": "/index.html" }
  ]
}
