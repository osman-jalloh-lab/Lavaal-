# Review reference only. Not read by the application and not an activation path.
# All flags default OFF in every environment. CHAT_VOICE_ENABLED is the unused
# ElevenLabs/paid-voice flag and does not enable browser speech.
# CHAT_BROWSER_VOICE_ENABLED is the free Web Speech option; it still requires
# chat eligibility and an explicit visitor tap, and does not activate A1.
CHAT_ENABLED=false
CHAT_VOICE_ENABLED=false
CHAT_BROWSER_VOICE_ENABLED=false
# Future adapter names only; blank placeholders are intentionally unusable.
CHAT_CUSTOMER_AGENT_ID=
CHAT_TRUSTED_ORIGINS=
CHAT_DRAFT_TOOL_SECRET=
CHAT_IP_HASH_SALT=
CHAT_DEDICATED_STORE_ADAPTER=
CHAT_ENFORCEABLE_VENDOR_SESSION_ADAPTER=
CHAT_ALL_IN_COST_ACCOUNTING_ADAPTER=
CHAT_VENDOR_HARD_LIMIT_ADAPTER=
# Existing contact transport names only; no credentials or destination values.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=
# No setting above activates A1. Dedicated durable storage, enforceable vendor
# sessions/quotas, all-in accounting and hard limits must be implemented and
# verified before A2. Do not use the ops store or a public-agent bypass.
