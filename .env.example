ICECAT_USERNAME=
ICECAT_PASSWORD=
ICECAT_API_TOKEN=
ICECAT_LANGUAGE=EN

# --- Quote form delivery (api/quote.js) ---
# URL that receives verified/sourcing quote requests from the product
# gallery quote panel. See AUDIT-PHASE1.md — this was flagged as unset in
# production; api/quote.js returns 503 delivery_not_configured until set.
QUOTE_WEBHOOK_URL=

# --- Contact Us form delivery (api/contact.js) ---
# URL of the Google Apps Script Web App deployment that actually sends the
# email (see scripts/email-router/contact-router.gs for full setup steps).
# api/contact.js returns 503 delivery_not_configured until this is set.
CONTACT_WEBHOOK_URL=
# Shared secret checked by contact-router.gs so only this site's backend
# can trigger a send through your Google Workspace account. Generate a
# long random value and set the SAME value in the Apps Script's
# Script Properties as CONTACT_WEBHOOK_SECRET.
CONTACT_WEBHOOK_SECRET=

# --- Slack Command Center (api/slack/*) ---
# HTTP handlers + classify/bridge. Never commit real secrets. After merge,
# set these in the Vercel project: Settings → Environment Variables, for
# Production and Preview, then redeploy so the functions see them.
# Request URLs (once DNS/app config is pointed at production):
#   https://www.lavaall.com/api/slack/events
#   https://www.lavaall.com/api/slack/commands
#   https://www.lavaall.com/api/slack/interactions
SLACK_SIGNING_SECRET=
# Bot User OAuth Token (xoxb-…). Used only for chat.postMessage handoff/replies.
SLACK_BOT_TOKEN=
# Channel ID for LAVAALL_TASK handoff posts. Not a secret.
# Defaults to C0C1V0HN3GA when unset.
LAVAALL_HANDOFF_CHANNEL=
# Optional. Non-empty presence only: classify treats claude-api /
# chatgpt-api as CONNECTED helpers (never lead). Registry JSON stays
# UNAVAILABLE. Values are never logged or committed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# /ops/chat (ticket 05) and /ops/routines Run (ticket 08) use those same
# keys as helpers only. lavaall-ceo remains lead via api/slack/_router/classify.
# No keys in the browser. If both unset, chat/routines show a setup or
# helper-not-connected error (no invented replies) except when chat can
# read a stored next step. Routines never auto-send mail or schedule jobs.
# Optional model name overrides (not secrets):
# OPS_CHAT_ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# OPS_CHAT_OPENAI_MODEL=gpt-4o-mini

# --- LAVAALL OS /ops magic-link auth (api/ops/*) ---
# HMAC secret for magic-link tokens and the lavaall_ops session cookie.
# Generate a long random value (32+ chars). Preview and Production.
OPS_AUTH_SECRET=
# Public origin used in emailed magic links when Host headers are unreliable.
# Example: https://<preview>.vercel.app  or  https://www.lavaall.com
OPS_PUBLIC_URL=
# Email sending. Resend is primary; Gmail REST is fallback; webhook is last remote path.
# Names only; no secrets here.
# 1) Resend (primary). Key must start with re_. From must be a verified Resend sender.
RESEND_API_KEY=
OPS_FROM_EMAIL=
# 2) Gmail API for magic-link fallback AND /ops inbox (ticket 06).
# Refresh token must belong to the mailbox in OPS_GMAIL_FROM.
# Live list/read/confirm-send only when OPS_GMAIL_FROM=support@lavaall.com.
# If the token is a personal mailbox (Preview), paste snapshots still work
# and the Inbox page shows “Live support@ not connected”.
# OAuth scopes to grant when creating the refresh token:
#   https://www.googleapis.com/auth/gmail.readonly
#   https://www.googleapis.com/auth/gmail.send
# (gmail.modify also covers both if you prefer a single scope.)
# Founder steps to connect support@:
#   1. Google Cloud project → OAuth client (Web).
#   2. Authorize as support@lavaall.com with the scopes above.
#   3. Store refresh token + client id/secret in Vercel Preview env.
#   4. Set OPS_GMAIL_FROM=support@lavaall.com
#   5. Redeploy Preview. Inbox → Refresh live mail.
OPS_GMAIL_CLIENT_ID=
OPS_GMAIL_CLIENT_SECRET=
OPS_GMAIL_REFRESH_TOKEN=
OPS_GMAIL_FROM=
# 3) Webhook alternative (same idea as CONTACT_WEBHOOK_URL): POST { to, subject, text, html, secret }.
OPS_MAGIC_LINK_WEBHOOK_URL=
OPS_MAGIC_LINK_WEBHOOK_SECRET=
# Preview-only safety. Set to 1 on Vercel Preview if both Resend and Gmail fail:
# allowlisted success pages may show the one-time link for that request only.
# Never enable in Production. Never shown for non-allowlisted emails.
# OPS_PREVIEW_INLINE_LINK=
# Optional. Set to 0 only for local http:// testing so the session cookie is not Secure.
# OPS_AUTH_COOKIE_SECURE=
# Durable /ops store (ticket 03). Without these, Profile/Goals/Tasks still work
# in demo (process memory) and reset on a Vercel cold start. Hobby serverless
# memory is not shared across instances — bind KV for real durability.
#
# Exact Vercel KV bind (Hobby is fine; no token to invent by hand):
# 1. Open https://vercel.com → the lavaal project (osman14/lavaal).
# 2. Storage → Create Database → KV (Upstash Redis).
# 3. Name it e.g. lavaall-ops.
# 4. Connect it to the lavaal project.
# 5. Environments: enable Preview (required for this PR) and Production if wanted.
# 6. Vercel injects KV_REST_API_URL and KV_REST_API_TOKEN automatically
#    (also KV_URL / KV_REST_API_READ_ONLY_TOKEN — /ops only reads the two REST vars).
# 7. Redeploy the Preview for branch cursor/ops-magic-link-auth-7726
#    (Deployments → ⋯ → Redeploy) so api/ops sees the new env.
# 8. After redeploy, /ops drops the yellow “Demo store” banner.
# 9. Save a goal + 3 tasks, mark one Done, refresh — home and Projects agree.
# Do not paste tokens into git or this file.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional local-only JSON file for `node` without Vercel. Ignored when VERCEL=1
# or when KV is bound. Not a secret. Example: /tmp/lavaall-ops-v2.json
# OPS_STORE_FILE=

# --- /ops calendar (ticket 07) ---
# Manual agenda on /ops/calendar always works (KV) — create/edit/delete, all-day,
# overlap warnings for timed events. Google sync is optional and additive.
#
# Shared LAVAALL calendar only. Do NOT set this to "primary" (that would write
# Osman's personal calendar). Create a company calendar, share it with both
# founders, then paste the calendar id (often …@group.calendar.google.com).
OPS_GOOGLE_CALENDAR_ID=
# Reuse the Gmail OAuth client when possible. The refresh token must include a
# Calendar scope in addition to Gmail, OR set a separate calendar refresh token:
#   https://www.googleapis.com/auth/calendar
#   (calendar.events is enough for read + create on the shared calendar)
# Optional override if the Gmail token cannot hold Calendar scope:
# OPS_GOOGLE_CALENDAR_REFRESH_TOKEN=
# Google Workspace may block Calendar OAuth the same way support@ Gmail hits
# "Service Not Allowed" until an admin allows the app. Manual agenda still works.
# Out of scope: changing Workspace policy.
