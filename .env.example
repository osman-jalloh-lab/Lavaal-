ICECAT_USERNAME=
ICECAT_PASSWORD=
ICECAT_API_TOKEN=
ICECAT_LANGUAGE=EN

# --- Quote form delivery (api/quote.js) ---
# URL that receives verified/sourcing quote requests from the product
# gallery quote panel. See AUDIT-PHASE1.md — this was flagged as unset in
# production; api/quote.js returns 503 delivery_not_configured until set.
QUOTE_WEBHOOK_URL=

# --- Contact Us form delivery (api/contact.js) ---
# URL of the Google Apps Script Web App deployment that actually sends the
# email (see scripts/email-router/contact-router.gs for full setup steps).
# api/contact.js returns 503 delivery_not_configured until this is set.
CONTACT_WEBHOOK_URL=
# Shared secret checked by contact-router.gs so only this site's backend
# can trigger a send through your Google Workspace account. Generate a
# long random value and set the SAME value in the Apps Script's
# Script Properties as CONTACT_WEBHOOK_SECRET.
CONTACT_WEBHOOK_SECRET=

# --- Slack Command Center (api/slack/*) ---
# HTTP handlers + classify/bridge. Never commit real secrets. After merge,
# set these in the Vercel project: Settings → Environment Variables, for
# Production and Preview, then redeploy so the functions see them.
# Request URLs (once DNS/app config is pointed at production):
#   https://www.lavaall.com/api/slack/events
#   https://www.lavaall.com/api/slack/commands
#   https://www.lavaall.com/api/slack/interactions
SLACK_SIGNING_SECRET=
# Bot User OAuth Token (xoxb-…). Used only for chat.postMessage handoff/replies.
SLACK_BOT_TOKEN=
# Channel ID for LAVAALL_TASK handoff posts. Not a secret.
# Defaults to C0C1V0HN3GA when unset.
LAVAALL_HANDOFF_CHANNEL=
# Optional. Non-empty presence only: classify treats claude-api /
# chatgpt-api as CONNECTED helpers (never lead). Registry JSON stays
# UNAVAILABLE. Values are never logged or committed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- LAVAALL OS /ops magic-link auth (api/ops/*) ---
# HMAC secret for magic-link tokens and the lavaall_ops session cookie.
# Generate a long random value (32+ chars). Preview and Production.
OPS_AUTH_SECRET=
# Public origin used in emailed magic links when Host headers are unreliable.
# Example: https://<preview>.vercel.app  or  https://www.lavaall.com
OPS_PUBLIC_URL=
# Email sending — pick ONE path (Resend REST or webhook). Names only; no secrets here.
# 1) Resend: set both. From address must be a verified Resend sender/domain.
RESEND_API_KEY=
OPS_FROM_EMAIL=
# 2) Webhook alternative (same idea as CONTACT_WEBHOOK_URL): POST { to, subject, text, html, secret }.
OPS_MAGIC_LINK_WEBHOOK_URL=
OPS_MAGIC_LINK_WEBHOOK_SECRET=
# Optional. Set to 0 only for local http:// testing so the session cookie is not Secure.
# OPS_AUTH_COOKIE_SECURE=
