# Keep LAVAALL Web planning docs, the local dev runner and its test off the
# public site.
# The page itself lives in api/web/_site and is only reachable through
# api/web/index.js, which answers 404 unless the section is switched on.
docs/web/
scripts/web/
tests/test-web.js

# Mascot demo pages, local preview shots, and test outputs are not part of the site.
mascot/demo/
mascot/tests/
mascot/RESULTS.md
preview-shots/

# Internal sources are not deployment assets. Keep only the souls required by
# api/ops/index.js includeFiles; middleware denies their public static URLs.
/*.md
/tests/
/scripts/
/docs/*
!/docs/ops/
/docs/ops/*
!/docs/ops/souls/
